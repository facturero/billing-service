{
  "name": "billing-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all"
  },
  "dependencies": {
    "@facturero/outbox-relay": "^0.2.3",
    "@hono/node-server": "^2.1.9",
    "@hono/otel": "^1.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-mysql2": "^0.71.0",
    "@opentelemetry/instrumentation-sequelize": "^0.18.0",
    "@opentelemetry/instrumentation-undici": "^0.35.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "amqplib": "^0.10.4",
    "dinero.js": "^2.0.0-alpha.14",
    "dotenv": "^16.4.7",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "mysql2": "^3.11.0",
    "pdfkit": "^0.15.0",
    "sequelize": "^6.37.0",
    "sequelize-cli": "^6.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@types/amqplib": "^0.10.4",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.1.1"
  }
}
